{
  "name": "infoco-ui",
  "version": "0.1.0",
  "description": "Kit visual da INFOCO em Vue 3: cores e layout do FAQ, comportamento dos componentes do SICC e o Agente INFOCO.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": "github:nandovitor/infoco-ui",
  "exports": {
    ".": "./src/index.ts",
    "./estilo.css": "./src/estilo/estilo.css",
    "./fonte.css": "./src/estilo/fonte.css",
    "./agente": "./src/agente/montar.ts",
    "./simbolo.png": "./src/assets/simbolo.png",
    "./dist/*": "./dist/*"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build --config vite.agente.config.ts",
    "demo": "vite build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vitorfba/vue-treeselect": "1.0.6",
    "@vueuse/core": "^15.0.0",
    "gsap": "^3.15.0",
    "lucide-vue-next": "^0.544.0",
    "motion-v": "^1.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0",
    "vitest": "^4.1.0"
  }
}
